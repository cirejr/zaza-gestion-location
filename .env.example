# Core
DATABASE_URL="postgresql://user:password@ep-...neon.tech/naya?sslmode=require"
# Postgres pooler WebSocket (obligatoire : les transactions en dépendent)
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-...neon.tech/naya?sslmode=require"
# Branch Neon cible (ex. br-sweet-wind-b5ucg81p)
NEON_BRANCH=""
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
API_PORT=8787

# Better Auth
BETTER_AUTH_SECRET="replace-with-a-long-random-secret"
BETTER_AUTH_URL="http://localhost:3000"
# Google OAuth — valeurs depuis la console Google Cloud (voir .env.local local)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_AUTH_CALLBACK_URI=http://localhost:3000/api/auth/callback/google

# Uploads (bucket S3-compatible PRIVÉ nommé "uploads")
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION=""
AWS_ENDPOINT_URL_S3="https://s3.<région>.amazonaws.com"

# Webhooks de paiement
PAYMENT_WEBHOOK_SECRET="replace-with-a-random-secret"

# Mobile money — PayTech (fournisseur par défaut, sandbox via PAYTECH_ENV=test)
# Documentation officielle : https://doc.paytech.sn/doc_paytech.php
# Clés API depuis le dashboard PayTech → Paramètres → API
PAYTECH_API_URL="https://paytech.sn/api"
PAYTECH_API_KEY=""
PAYTECH_API_SECRET=""
PAYTECH_ENV="test"

# Alternatives déjà câblées (à remplacer en choisissant UNE passerelle en production)
PAYDUNYA_API_URL="https://app.paydunya.com/api/v1"
PAYDUNYA_KEY=""
PAYDUNYA_SECRET=""
FEDAPAY_API_URL="https://api.fedapay.com"
FEDAPAY_TOKEN=""

# WhatsApp — Meta Cloud API (template messages : naya_otp, relance_loyer, note_charges)
# Obtenir : développeurs.facebook.com → application WhatsApp → API Setup / système
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_GRAPH_VERSION="v23.0"
# Optionnel : identifiant du compte WhatsApp Business (info uniquement)
META_BUSINESS_ACCOUNT_ID=""

# SMS — Twilio. Canal de l'OTP par défaut : aucune approbation de template
# requise, contrairement à WhatsApp.
# Credentials : twilio.com/console → Account → API Keys & Tokens.
# ATTENTION — TWILIO_ACCOUNT_SID doit être le SID de COMPTE (préfixe "AC", 34
# caractères) : c'est lui qui apparaît dans l'URL de l'API. Une clé API ("SK…")
# à sa place fait échouer l'authentification (erreur 70051).
TWILIO_ACCOUNT_SID=""
# Auth Token du compte, ou le secret d'une clé API "SK…" (même syntaxe Basic).
TWILIO_AUTH_TOKEN=""

# Expéditeur alphanumérique (recommandé). Depuis le 2026-09-08, Orange et
# Expresso au Sénégal rejettent les numéros longue distance internationaux avec
# l'erreur 21612 — ce que sont tous les numéros Twilio. Un identifiant
# alphanumérique (11 caractères max) passe dans le même champ "From".
TWILIO_SENDER_ID=""

# Numéro long international. Repli uniquement : ignoré si TWILIO_SENDER_ID est
# défini, refusé par Orange/Expresso au Sénégal.
TWILIO_FROM_NUMBER=""

# WhatsApp via Twilio — même réseau WhatsApp que l'API Cloud de Meta, sans revue
# d'application Meta. Nécessite un numéro Twilio avec WhatsApp activé.
# Vérifier d'abord la couverture WhatsApp de Twilio pour le Sénégal (+221) :
# https://www.twilio.com/docs/whatsapp
# Format accepté : "+14155238886" ou "whatsapp:+14155238886".
TWILIO_WHATSAPP_FROM=""

# Templates de contenu Twilio (SID "HX…"), créés via l'API Content puis approuvés
# par WhatsApp. Laisser vide => le canal WhatsApp est considéré non configuré et
# l'envoi bascule sur le canal suivant.
#   POST https://content.twilio.com/v1/Content  -u $TWILIO_API_KEY:$TWILIO_API_SECRET
# OTP : type "whatsapp/authentication". IMPORTANT — créer avec
# code_expiration_minutes: 5, la durée que le reste de l'application suppose.
TWILIO_WHATSAPP_AUTH_CONTENT_SID=""
# Rappel de loyer : template WhatsApp classique, placeholders 1..5 =
# nom, unité, immeuble, échéance, montant.
TWILIO_WHATSAPP_RENT_CONTENT_SID=""
# Note de charges : placeholders 1..5 = nom, type, période, montant, unité.
TWILIO_WHATSAPP_UTILITY_CONTENT_SID=""
